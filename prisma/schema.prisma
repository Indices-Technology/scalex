generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ScaleX never reads another app's tables. `tenant` is the app that owns the row (MarketX is
// "marketx"); it comes from the API key, never from the request body.

/// A business we might bring onto a tenant's platform. v0: prospective MarketX sellers.
model Lead {
  id         String     @id @default(uuid())
  tenant     String
  /// The import it came in with ("oct-balogun-walk"), so results compare batch to batch.
  batch      String
  source     LeadSource
  name       String
  /// +234… when we could read it, otherwise null.
  phone      String?
  email      String?
  /// Handle only, lower case, no @.
  instagram  String?
  city       String?
  category   String?
  notes      String     @default("")
  /// Ranking at import time (leadRules.scoreLead). Higher = contact first.
  score      Int
  /// Goes in the lead's personal sign-up link. The tenant reports progress against it.
  inviteCode String     @unique
  /// The same business imported twice collapses onto one row (leadRules.dedupeKey).
  dedupeKey  String
  status     LeadStatus @default(NEW)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  events     LeadEvent[]

  @@unique([tenant, dedupeKey])
  @@index([tenant, batch, status])
  @@index([tenant, score])
}

/// One step a lead reached. One row per step per lead, so a retried report never counts twice.
model LeadEvent {
  id     String     @id @default(uuid())
  leadId String
  type   LeadStatus
  at     DateTime   @default(now())
  lead   Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, type])
}

enum LeadSource {
  CSV
  INTERNAL
  PLACES
}

/// In funnel order. NOT_INTERESTED is the only way out, and only before sign-up.
enum LeadStatus {
  NEW
  CONTACTED
  SIGNED_UP
  STORE_CREATED
  FIRST_LISTING
  FIRST_ORDER
  NOT_INTERESTED
}

/// Every LLM call ScaleX makes, ok or not: who it was for, which prompt asked, what it cost.
/// The billing record and the "no black hole" record. Only core's model gateway writes it.
model ModelCall {
  id            String         @id @default(uuid())
  tenant        String
  /// What asked, e.g. 'listing-proposal'.
  task          String
  promptVersion String
  model         String
  inputTokens   Int            @default(0)
  outputTokens  Int            @default(0)
  /// Millionths of a US dollar, so sums are exact. Null when the model has no price in the
  /// gateway's table: never a guess.
  costMicros    Int?
  ms            Int
  stopReason    String?
  ok            Boolean
  error         String?
  requestId     String?
  createdAt     DateTime       @default(now())
  optimizations Optimization[]

  @@index([tenant, createdAt])
}

/// One proposed listing change for one product (step 0.4b). The client applies it in its own
/// system and reports back what it published; ScaleX never writes into a client's data.
model Optimization {
  id            String             @id @default(uuid())
  tenant        String
  /// The client's own refs, opaque to us. productRef is null while the product is still being
  /// added; the client sends it with /applied once the product exists.
  sellerRef     String
  productRef    String?
  /// The earlier round this one refines with the seller's answers.
  parentId      String?
  promptVersion String
  /// What we were given (product, allowed categories, answers) and what we proposed.
  input         Json
  proposal      Json
  /// checkProposal's reasons it can't be used as-is. Empty = READY.
  problems      String[]
  status        OptimizationStatus
  /// What the client actually published, seller's edits included. The gap between this and
  /// `proposal` is how we learn what the seller would not accept.
  applied       Json?
  rejectReason  String?
  decidedAt     DateTime?
  modelCallId   String
  modelCall     ModelCall          @relation(fields: [modelCallId], references: [id])
  parent        Optimization?      @relation("Rounds", fields: [parentId], references: [id])
  children      Optimization[]     @relation("Rounds")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([tenant, status, createdAt])
  @@index([tenant, productRef])
}

/// READY passes the code checks; NEEDS_REVIEW doesn't. A later round makes its parent SUPERSEDED.
enum OptimizationStatus {
  READY
  NEEDS_REVIEW
  APPLIED
  REJECTED
  SUPERSEDED
}
