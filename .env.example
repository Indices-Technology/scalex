# ScaleX's own database (NOT the MarketX one). Local Postgres or a separate Neon database.
# Run migrations over a direct (non-pooler) URL: the pooler hangs on Prisma's advisory lock.
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/scalex

# Who may call the API: comma-separated tenant:key pairs. MarketX is tenant one.
# Make a key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SCALEX_API_KEYS=marketx:<long-random-key>

# What a good lead looks like right now (lower case, comma-separated). Used to rank leads on import.
SCALEX_TARGET_CATEGORIES=fashion,abaya
SCALEX_TARGET_CITIES=lagos,ibadan,abuja

# The model gateway (layers/core/server/utils/modelGateway.ts). ScaleX's own key, so its cost is separate.
ANTHROPIC_API_KEY=sk-ant-<key>
# Daily AI spend cap per tenant, in USD. Calls past it get 429 AI_CAP_REACHED.
SCALEX_DAILY_AI_USD=5
# Session/direct connection for prisma migrate (Supabase: port 5432, not the 6543 pooler)
DIRECT_URL=
# Key MarketX issued to ScaleX (MarketX SCALEX_INBOUND_KEY)
MARKETX_INBOUND_KEY=
